---
import Icon from "./Icon.astro";
---

<button class="wa-fab" type="button" id="wa-fab" aria-expanded="false" aria-controls="wa">
  <Icon name="whatsapp" size={24} />
  <span class="wa-fab__label">Probar el bot de WhatsApp</span>
</button>
<div class="wa" id="wa" role="dialog" aria-label="Chat de WhatsApp simulado" hidden>
  <div class="wa__top">
    <span class="wa__avatar" aria-hidden="true"><Icon name="whatsapp" size={22} /></span>
    <div class="wa__who"><b id="wa-name">Asistente</b><small>en línea · demo</small></div>
    <button type="button" class="wa__close" id="wa-close" aria-label="Cerrar chat"><Icon name="x" size={20} /></button>
  </div>
  <div class="wa__log" id="wa-log" aria-live="polite"></div>
  <form class="wa__form" id="wa-form" hidden>
    <input id="wa-input" autocomplete="off" aria-label="Escribí un mensaje" placeholder="Escribí un mensaje" />
    <button type="submit" aria-label="Enviar"><Icon name="send" size={20} /></button>
  </form>
</div>

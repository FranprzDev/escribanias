---
import "../styles/global.css";
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Página no encontrada · Turnero</title>
  </head>
  <body>
    <main class="notfound">
      <h1>No encontramos esta página</h1>
      <p>Revisá el enlace que recibiste. Si el problema sigue, escribinos y te mandamos el correcto.</p>
      <p><a class="btn btn--primary" href={home}>Ver la demo general</a></p>
    </main>
  </body>
</html>

---
import Icon from "./Icon.astro";
---

<section class="section mis" id="mis" aria-label="Mis turnos y estado de trámite">
  <div class="mis__grid">
    <div class="mis__col">
      <h2>Mis turnos</h2>
      <p class="section__sub">Los que sacaste en esta visita, desde la web o por WhatsApp.</p>
      <ul class="turnos" id="mis-list"></ul>
    </div>
    <div class="mis__col mis__col--lookup">
      <h2>Estado de tu trámite</h2>
      <p class="section__sub">Ingresá el código de tu turno para ver en qué etapa está.</p>
      <form class="lookup" id="lookup" novalidate>
        <label class="field field--inline">
          <span class="sr-only">Código de turno</span>
          <span class="field__ico"><Icon name="search" size={18} /></span>
          <input name="code" autocomplete="off" placeholder="Ej. ESC-2041" aria-label="Código de turno" />
        </label>
        <button class="btn btn--primary" type="submit">Consultar</button>
      </form>
      <div id="lookup-out" aria-live="polite"></div>
    </div>
  </div>
</section>

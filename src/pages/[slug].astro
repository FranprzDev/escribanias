---
// Una página estática por escribanía, generada desde src/data/escribanias.json.
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import App from "../components/App.astro";
import { ESCRIBANIAS } from "../lib/escribanias";

export const getStaticPaths = (() => ESCRIBANIAS.map((office) => ({ params: { slug: office.slug }, props: { office } }))) satisfies GetStaticPaths;

const { office } = Astro.props;
---

<Layout office={office}>
  <App office={office} />
</Layout>

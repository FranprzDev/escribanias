---
import { DEFAULT_NAME, displayName, firstPhone, HORARIO, shortAddress, type Escribania } from "../lib/escribanias";
import Icon from "./Icon.astro";

interface Props {
  office?: Escribania | null;
}
const { office = null } = Astro.props;
const name = office ? displayName(office.nombre) : DEFAULT_NAME;
const dir = office ? shortAddress(office.direccion) : "";
const tel = office ? firstPhone(office.telefono) : "";
---

<section class="office" aria-labelledby="o-nombre">
  <div class="office__inner">
    <div class="office__id">
      <p class="office__kicker">Turnos online</p>
      <h1 id="o-nombre" class="office__name">{name}</h1>
      <p class="office__titular">
        {office ? (
          <>
            {office.registro && <>Registro notarial Nº {office.registro}</>}
            {office.registro && office.titular && <span class="sep" aria-hidden="true" />}
            {office.titular && <>Esc. {office.titular}</>}
          </>
        ) : (
          <>Así ven sus clientes el turnero de una escribanía: reservan solos, a toda hora, y usted ve todo en su panel.</>
        )}
      </p>
    </div>
    <ul id="o-info" class="office__info">
      {dir && <li><Icon name="pin" /><span>{dir}</span></li>}
      {tel && <li><Icon name="phone" /><span>Tel. {tel}</span></li>}
      <li><Icon name="clock" /><span>{HORARIO}</span></li>
    </ul>
  </div>
</section>

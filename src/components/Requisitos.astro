---
import { TRAMITES } from "../lib/tramites";
import { TRAMITE_ICON } from "../lib/icons";
import Icon from "./Icon.astro";
---

<section class="section reqlist" id="requisitos" aria-labelledby="req-title">
  <div class="section__head">
    <h2 id="req-title">Qué traer a cada trámite</h2>
    <p class="section__sub">Llegá con todo listo y evitá una segunda visita.</p>
  </div>
  <ul class="reqlist__rows">
    {
      TRAMITES.map((t) => (
        <li class="reqlist__row">
          <div class="reqlist__name">
            <span class="reqlist__ico"><Icon name={TRAMITE_ICON[t.nombre] ?? "help"} size={20} /></span>
            <h3>{t.nombre}</h3>
            <span class="reqlist__dur">{t.duracion}</span>
          </div>
          <ul class="ticks">
            {t.requisitos.map((r) => (
              <li><Icon name="check" size={16} />{r}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

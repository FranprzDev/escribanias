<section class="section" id="panel">
  <div class="head">
    <p class="head__eyebrow">Vista escribano · demo</p>
    <h2>Panel del escribano</h2>
    <p class="head__sub" id="p-sub">Agenda, recordatorios, bloqueos y trámites en un solo lugar.</p>
  </div>
  <div id="p-gate">
    <aside class="callout" aria-label="Ingreso">
      <p class="callout__head">Acceso de demostración</p>
      <p class="callout__lead"><strong>Sin contraseña.</strong> Es una demo: entrás directo al panel y los cambios viven solo en esta pestaña.</p>
      <button class="btn btn--primary" type="button" id="p-login">Entrar</button>
    </aside>
  </div>
  <div class="stack" id="p-app" hidden>
    <section class="stats" aria-live="polite">
      <div class="stat"><span class="stat__fig" id="k-hoy">0</span><span class="stat__label">Turnos de hoy</span></div>
      <div class="stat"><span class="stat__fig" id="k-sem">0</span><span class="stat__label">Turnos esta semana</span></div>
      <div class="stat"><span class="stat__fig" id="k-rec">0</span><span class="stat__label">Recordatorios enviados</span></div>
      <div class="stat"><span class="stat__fig" id="k-tra">0</span><span class="stat__label">Trámites en curso</span></div>
    </section>

    <div class="block">
      <h3 class="h3">Agenda</h3>
      <div class="dayer">
        <button class="btn" type="button" id="p-prev" aria-label="Día anterior">‹<span class="hide-sm"> Anterior</span></button>
        <b id="p-day" aria-live="polite"></b>
        <button class="btn" type="button" id="p-next" aria-label="Día siguiente"><span class="hide-sm">Siguiente </span>›</button>
      </div>
      <div class="table-wrap">
        <table class="rtable">
          <thead><tr><th scope="col">Hora</th><th scope="col">Cliente</th><th scope="col">Trámite</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
          <tbody id="p-rows"></tbody>
        </table>
      </div>
      <p class="fineprint">«Enviar recordatorio» abre WhatsApp con el mensaje listo. Los turnos que se sacan en la web o por chat aparecen acá al instante.</p>
    </div>

    <div class="block">
      <h3 class="h3">Bloquear horario</h3>
      <form class="form form--row" id="blk-form" novalidate>
        <label>Fecha<input type="date" name="fecha" id="blk-fecha" /></label>
        <label>Desde<select name="desde" id="blk-desde"></select></label>
        <label>Hasta<select name="hasta" id="blk-hasta"></select></label>
        <button class="btn btn--primary" type="submit">Bloquear</button>
      </form>
      <p class="msg" id="blk-msg" aria-live="polite"></p>
      <ul class="checklist" id="blk-list" hidden></ul>
    </div>

    <div class="block">
      <h3 class="h3">Trámites</h3>
      <div class="table-wrap">
        <table class="rtable">
          <thead><tr><th scope="col">Código</th><th scope="col">Cliente</th><th scope="col">Trámite</th><th scope="col">Estado</th></tr></thead>
          <tbody id="t-rows"></tbody>
        </table>
      </div>
      <p class="fineprint">El cliente ve el cambio al consultar su código en la web o en el chat.</p>
    </div>

    <div class="links">
      <button class="btn btn--primary" type="button" id="p-csv">Exportar agenda (CSV)</button>
      <button class="btn" type="button" id="p-logout">Salir del panel</button>
    </div>
  </div>
</section>

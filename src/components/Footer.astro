---
import { DEFAULT_NAME, displayName, shortAddress, type Escribania } from "../lib/escribanias";
import Icon from "./Icon.astro";
import Seal from "./Seal.astro";
interface Props {
  office?: Escribania | null;
}
const { office = null } = Astro.props;
const name = office ? displayName(office.nombre) : DEFAULT_NAME;
const dir = office ? shortAddress(office.direccion) : "";
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__office">
      <Seal office={office} size="l" />
      <div>
        <p class="foot__name">{name}</p>
        {office && (
          <ul class="foot__lines">
            {office.registro && <li>Registro notarial Nº {office.registro}{office.titular && `, Esc. ${office.titular}`}</li>}
            {dir && <li>{dir}</li>}
            {office.telefono && <li>Tel. {office.telefono}</li>}
          </ul>
        )}
        <p class="foot__links"><a href="#turno">Reservar turno</a><a href="#requisitos">Requisitos</a><a href="#panel">Ver el panel del escribano</a></p>
      </div>
    </div>
    <div class="foot__demo">
      <p id="foot-text">Demo creada por Francisco Perez para {name}. Es una demostración: no se envían turnos reales.</p>
      <div class="actions">
        <a class="btn btn--light" href="mailto:franciscoperezdeveloper@gmail.com?subject=Turnero%20online"><Icon name="mail" size={18} />Escribime por email</a>
        <a class="btn btn--light" href="https://wa.me/5493815412480" rel="noopener" target="_blank"><Icon name="whatsapp" size={18} />Escribime por WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
